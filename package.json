{
    "name": "@harmoniclabs/gerolamo",
    "version": "0.0.1-dev16",
    "description": "A Cardano full node implementation in TypeScript",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "bun src/index.ts",
        "explorer": "bun scripts/gerolamo-explorer.ts",
        "stream-server": "bun scripts/mithril-stream-server.ts",
        "ui:dev": "bash desktop/scripts/dev-wait.sh",
        "browser:dev": "bun run --cwd browser dev",
        "browser:build": "bun run --cwd browser build",
        "browser:probe": "bun browser/scripts/probe.ts",
        "browser:test": "bun test --cwd browser src",
        "ui:typecheck": "bun run --cwd desktop typecheck",
        "ui:test": "bun test --cwd desktop src",
        "postinstall": "bun install --cwd desktop && bun install --cwd dashboard",
        "preflight": "bun scripts/preflight.ts",
        "setup": "bun install && bun run preflight",
        "test": "bun test ./src && bun test --cwd desktop src && bun test --cwd browser src"
    },
    "devDependencies": {
        "@harmoniclabs/cddl-tools": "^0.0.4",
        "@types/bun": "^1.3.7"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@blockfrost/blockfrost-js": "^6.1.0",
        "@harmoniclabs/buildooor": "^0.1.21",
        "@harmoniclabs/cardano-ledger-ts": "file:vendor/harmoniclabs-cardano-ledger-ts-0.5.13.tgz",
        "@harmoniclabs/cardano-math-ts": "^0.0.5",
        "@harmoniclabs/cbor": "^1.6.6",
        "@harmoniclabs/crypto": "^0.3.0",
        "@harmoniclabs/kes": "file:vendor/harmoniclabs-kes-0.1.0-dev1.tgz",
        "@harmoniclabs/obj-utils": "^1.0.0",
        "@harmoniclabs/ouroboros-miniprotocols-ts": "^0.0.5-dev7",
        "@harmoniclabs/shared-cardano-mempool-ts": "file:vendor/harmoniclabs-shared-cardano-mempool-ts-0.0.0.tgz",
        "@harmoniclabs/uint8array-utils": "^1.0.4",
        "@harmoniclabs/uplc": "^1.4.1",
        "@noble/curves": "1.9.7",
        "@noble/hashes": "1.7.2",
        "commander": "^14.0.2",
        "fzstd": "^0.1.1",
        "picocolors": "^1.1.1",
        "tar-stream": "^3.2.0",
        "typescript-language-server": "^5.1.3"
    },
    "engines": {
        "bun": ">=1.1.0"
    },
    "patchedDependencies": {
        "@harmoniclabs/ouroboros-miniprotocols-ts@0.0.5-dev7": "patches/@harmoniclabs%2Fouroboros-miniprotocols-ts@0.0.5-dev7.patch",
        "@harmoniclabs/plutus-machine@2.1.3": "patches/@harmoniclabs%2Fplutus-machine@2.1.3.patch",
        "@harmoniclabs/uint8array-utils@1.0.4": "patches/@harmoniclabs%2Fuint8array-utils@1.0.4.patch",
        "@harmoniclabs/buildooor@0.1.31": "patches/@harmoniclabs%2Fbuildooor@0.1.31.patch",
        "@harmoniclabs/cardano-ledger-ts@0.4.8": "patches/@harmoniclabs%2Fcardano-ledger-ts@0.4.8.patch",
        "@harmoniclabs/cbor@1.6.6": "patches/@harmoniclabs%2Fcbor@1.6.6.patch",
        "@harmoniclabs/plutus-data@1.2.6": "patches/@harmoniclabs%2Fplutus-data@1.2.6.patch"
    }
}
