{
    "compilerOptions": {
        "skipLibCheck": true,
        "target": "ESNext",
        "module": "ESNext",
        "allowJs": true,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": ".",
        "downlevelIteration": true,
        "strict": false,
        "noImplicitAny": false,
        "strictNullChecks": true,
        "strictFunctionTypes": false,
        "strictBindCallApply": true,
        "strictPropertyInitialization": false,
        "noImplicitThis": true,
        "alwaysStrict": false,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@harmoniclabs/mithril-ts/node": ["node_modules/@harmoniclabs/mithril-ts/dist/node/index.d.ts"]
        },
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "preserve",
        "jsxImportSource": "solid-js"
    },
    "tsc-alias": {
        "verbose": false,
        "resolveFullPaths": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "dashboard",
        "scripts"
    ]
}
